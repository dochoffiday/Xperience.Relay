<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props sets a single TargetFramework; clear it so multi-targeting takes effect. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <PackageId>Xperience.Relay.Contracts</PackageId>
    <Description>Wire contracts (commands, results, discovery metadata) for Xperience.Relay -- a remote command-dispatch layer for Xperience by Kentico. Has no dependency on the Kentico SDK, so it's safe to reference from external clients.</Description>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
